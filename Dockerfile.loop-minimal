# syntax=docker/dockerfile:1.7

# Official PyTorch CUDA 12.8 runtime, pinned to the linux/amd64 manifest. This
# removes the Jupyter, SSH, FileBrowser, compiler, Manager, and general-purpose
# tooling present in the RunPod ComfyUI base while preserving the exact
# Blackwell-capable torch family used by the validated full image.
ARG BASE_IMAGE=pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime@sha256:b85566342b86d13a67712e9315d40cdc2dad7f8d86df1aff3831f80835edbcca
FROM ${BASE_IMAGE}

ARG COMFYUI_COMMIT=7c8450ef2b720bb096f0d94ff933c62fd174cb57
ARG CUSTOM_NODES_MANIFEST=custom_nodes.loop.txt
ARG IMAGE_PROFILE=loop-minimal

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_CONSTRAINT=/opt/comfyui-runtime-constraints.txt \
    EXPECTED_TORCH_VERSION=2.10.0+cu128 \
    EXPECTED_TORCHVISION_VERSION=0.25.0+cu128 \
    EXPECTED_TORCHAUDIO_VERSION=2.10.0+cu128 \
    EXPECTED_TORCH_CUDA=12.8 \
    NVIDIA_REQUIRE_CUDA="" \
    NVIDIA_DISABLE_REQUIRE=true \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# The pinned PyTorch image owns /usr/local/lib/python3.12, so Ubuntu's PEP 668
# system-package marker is not applicable to this image-managed runtime.
RUN printf '%s\n' \
        'torch==2.10.0+cu128' \
        'torchvision==0.25.0+cu128' \
        'torchaudio==2.10.0+cu128' \
        > /opt/comfyui-runtime-constraints.txt \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        aria2 \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

# Use the same ComfyUI revision as the validated RunPod 1.4.4 base, but install
# only ComfyUI itself. The commit archive avoids shipping another .git object
# database in the runtime layer.
RUN mkdir -p /opt/comfyui-baked \
    && curl --fail --location --retry 5 --retry-all-errors \
        "https://github.com/Comfy-Org/ComfyUI/archive/${COMFYUI_COMMIT}.tar.gz" \
        --output /tmp/comfyui.tar.gz \
    && tar -xzf /tmp/comfyui.tar.gz --strip-components=1 -C /opt/comfyui-baked \
    && rm -f /tmp/comfyui.tar.gz \
    && "$(command -v python || command -v python3)" -m pip install --no-cache-dir \
        -r /opt/comfyui-baked/requirements.txt

COPY ${CUSTOM_NODES_MANIFEST} /opt/runpod-wan-animate/custom_nodes.txt
COPY config/ /opt/runpod-wan-animate/config/
COPY scripts/ /opt/runpod-wan-animate/scripts/
COPY workflows/ /opt/runpod-wan-animate/workflows/
COPY custom_nodes/ /opt/comfyui-baked/custom_nodes/

RUN "$(command -v python || command -v python3)" -m pip install --no-cache-dir \
        -r /opt/comfyui-baked/custom_nodes/ComfyUI-WanLoopBatch/requirements.txt \
    && "$(command -v python || command -v python3)" -c \
        "import ultralytics; assert ultralytics.__version__ == '8.4.104'"

RUN set -eu; \
    PYTHON_BIN="$(command -v python || command -v python3)"; \
    "${PYTHON_BIN}" -m pip install --no-cache-dir \
        --target /opt/runpod-wan-animate/downloader-libs \
        huggingface_hub==1.24.0 \
        hf-xet==1.5.2

RUN chmod +x /opt/runpod-wan-animate/scripts/*.sh \
    && /opt/runpod-wan-animate/scripts/install_custom_nodes.sh

# Fail the build if either the CUDA wheel family or the core inference/runtime
# imports drift. GPU execution itself is rechecked on every assigned Pod.
RUN "$(command -v python || command -v python3)" \
        /opt/runpod-wan-animate/scripts/gpu_preflight.py --stack-only \
    && cd /opt/comfyui-baked \
    && "$(command -v python || command -v python3)" -c \
        "import aiohttp, av, cv2, transformers, comfy"

ARG BUNDLE_REVISION=unknown
ENV BUNDLE_REVISION=${BUNDLE_REVISION}
LABEL org.opencontainers.image.revision="${BUNDLE_REVISION}" \
      io.grawthings.wan.image-profile="${IMAGE_PROFILE}" \
      org.opencontainers.image.base.name="pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime"

EXPOSE 8188
WORKDIR /opt/comfyui-baked
ENTRYPOINT []
CMD ["/opt/runpod-wan-animate/scripts/start.sh"]
