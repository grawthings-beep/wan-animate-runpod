 succeeds, the browser downloads one ZIP with slot-01.mp4 through slot-10.mp4 plus manifest.json.\n\nDo not use the normal Queue button for this preset. A failed earlier job intentionally prevents an incomplete ZIP from downloading.","color":"#222","bgcolor":"#000","shape":1},{"id":328,"type":"mxSlider2D","pos":[3110,950],"size":[480,330],"flags":{},"order":74,"mode":0,"inputs":[{"localized_name":"Xi","name":"Xi","type":"INT","widget":{"name":"Xi"},"link":null},{"localized_name":"Xf","name":"Xf","type":"FLOAT","widget":{"name":"Xf"},"link":null},{"localized_name":"Yi","name":"Yi","type":"INT","widget":{"name":"Yi"},"link":null},{"localized_name":"Yf","name":"Yf","type":"FLOAT","widget":{"name":"Yf"},"link":null},{"localized_name":"isfloatX","name":"isfloatX","type":"INT","widget":{"name":"isfloatX"},"link":null},{"localized_name":"isfloatY","name":"isfloatY","type":"INT","widget":{"name":"isfloatY"},"link":null}],"outputs":[{"localized_name":"","name":"","type":"INT","links":[455]},{"localized_name":"","name":"","type":"INT","links":[456]}],"title":"VIDEO Width x Height","properties":{"valueX":528,"valueY":704,"minX":0,"minY":0,"maxX":1024,"maxY":1024,"stepX":16,"stepY":16,"decimalsX":0,"decimalsY":0,"snap":true,"dots":true,"frame":true,"frameAlert":0,"Node name for S&R":"mxSlider2D","widget_ue_connectable":{}},"widgets_values":[528,528,704,704,0,0],"color":"#232","bgcolor":"#353","shape":1},{"id":404,"type":"UpscaleModelLoader","pos":[4750,1060],"size":[270,58],"flags":{},"order":139,"mode":0,"inputs":[{"name":"model_name","type":"COMBO","widget":{"name":"model_name"},"link":null}],"outputs":[{"name":"UPSCALE_MODEL","type":"UPSCALE_MODEL","links":[502]}],"title":"AI UPSCALE MODEL (67 MB)","properties":{"Node name for S&R":"UpscaleModelLoader","cnr_id":"comfy-core"},"widgets_values":"4x_NMKD-Siax_200k.pth","color":"#233","bgcolor":"#355"},{"id":405,"type":"ImageUpscaleWithModel","pos":[5040,1060],"size":[250,72],"flags":{},"order":140,"mode":0,"inputs":[{"name":"ups