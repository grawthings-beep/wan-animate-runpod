PORT=8188
LISTEN=0.0.0.0
RUN_DEP_CHECK=0
DOWNLOAD_MODELS=1
HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}
MODEL_MANIFEST_URL=https://raw.githubusercontent.com/grawthings-beep/wan-animate-runpod/main/config/wan-animate-models.json
ARIA2_CONNECTIONS=16
ARIA2_SPLITS=16
COMFYUI_ARGS=--reserve-vram 2

# All Wan2.2 Animate model files used here are public on Hugging Face, so
# HF_TOKEN is optional (kept for parity / future gated files).
#
# Optional: add extra LoRAs/checkpoints without editing the base manifest.
# EXTRA_MODEL_MANIFEST_JSON={"models":[{"name":"My Wan LoRA","enabled":true,"required":false,"method":"curl","url":"https://huggingface.co/USER/REPO/resolve/main/my_lora.safetensors","path":"models/loras/wan/my_lora.safetensors","min_bytes":1048576}]}
