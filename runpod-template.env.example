PORT=8188
LISTEN=0.0.0.0
RUN_DEP_CHECK=0
DOWNLOAD_MODELS=1
HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}
MODEL_MANIFEST_URL=https://raw.githubusercontent.com/grawthings-beep/wan-animate-runpod/main/config/ltx-models.json
ARIA2_CONNECTIONS=16
ARIA2_SPLITS=16
COMFYUI_ARGS=--reserve-vram 2

# All LTX-2.3 model files used here are public on Hugging Face, so HF_TOKEN is
# optional. You can also leave MODEL_MANIFEST_URL unset entirely — the image
# bakes config/ltx-models.json and start.sh falls back to it.
#
# Optional: add extra LoRAs/checkpoints without editing the base manifest.
# EXTRA_MODEL_MANIFEST_JSON={"models":[{"name":"My LTX LoRA","enabled":true,"required":false,"url":"https://huggingface.co/USER/REPO/resolve/main/my_lora.safetensors","path":"models/loras/ltx2/my_lora.safetensors","min_bytes":1048576}]}
