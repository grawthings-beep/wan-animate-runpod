PORT=8188
LISTEN=0.0.0.0
DOWNLOAD_MODELS=1
MODEL_PROFILE=full
CIVITAI_API_TOKEN={{ RUNPOD_SECRET_civitai_api_token }}
RUN_DEP_CHECK=1
ARIA2_CONNECTIONS=16
ARIA2_SPLITS=16
COMFYUI_ARGS=--reserve-vram 3

# Optional. Public Hugging Face files used by the default manifest do not need it.
# HF_TOKEN={{ RUNPOD_SECRET_huggingface_token }}

# Optional profiles: i2v-quality, loop-quality, t2v-quality.
# full is the requested everything-included profile and requires CIVITAI_API_TOKEN.
