# RunPod Networking configurationにも HTTP Port 8188 を追加する。
PORT=8188
LISTEN=0.0.0.0

# loop-core: ONのLoRAだけ（40.96 GB） / loop-all: 任意LoRAも全部（46.13 GB）
DOWNLOAD_MODELS=1
MODEL_PROFILE=loop-all
RUN_DEP_CHECK=1

# 起動直後から8188に進捗・失敗理由を表示する。
BOOTSTRAP_STATUS=1
BOOT_FAILURE_HOLD_SECONDS=900

# 46 GBを毎回取得する前提の高速転送設定。
DOWNLOAD_WORKERS=4
ARIA2_CONNECTIONS=16
ARIA2_SPLITS=16
HF_SNAPSHOT_WORKERS=8
HF_XET_HIGH_PERFORMANCE=1
HF_XET_NUM_CONCURRENT_RANGE_GETS=64
HF_XET_CHUNK_CACHE_SIZE_BYTES=0
HF_HUB_DOWNLOAD_TIMEOUT=300

# RunPod Secretsの鍵アイコンから割り当てる。平文tokenを貼らない。
CIVITAI_API_TOKEN={{ RUNPOD_SECRET_CIVITAI_TOKEN }}
HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}

# GPU/image不一致と壊れたhostをモデル取得前に止める。
CUDA_NORMALIZE_VISIBLE_DEVICES=1
CUDA_PREFLIGHT=1
CUDA_READY_TIMEOUT=90
CUDA_READY_INTERVAL=10

# 容量不足を1 byteも取得する前に検出する。
MODEL_DISK_PREFLIGHT=1
MODEL_DISK_HEADROOM_GB=12

YOLO_CONFIG_DIR=/workspace/.cache/ultralytics
YOLO_AUTOINSTALL=false
YOLO_OFFLINE=true
COMFYUI_ARGS=--reserve-vram 3 --max-upload-size 300

# 通常は設定不要。必要な場合だけ上書きする。
# WORKSPACE_DIR=/workspace/comfyui
# MODEL_ROOT=/workspace/comfyui
# CONFIG_DIR=/workspace/config
# MODEL_MANIFEST=/workspace/config/wan22-models.json
# MODEL_MANIFEST_URL=
# MODEL_MANIFEST_JSON=
# WORKFLOW_SRC=/opt/runpod-wan-animate/workflows
# WORKFLOW_DST=/workspace/comfyui/user/default/workflows
# HF_HOME=/workspace/.cache/huggingface
# HF_XET_CACHE=/workspace/.cache/huggingface/xet
# TORCH_HOME=/workspace/.cache/torch
# XDG_CACHE_HOME=/workspace/.cache
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# COMFYUI_DATABASE_URL=sqlite:////workspace/comfyui/user/comfyui.db
# COMFYUI_CORS_ORIGIN=
